{
  "name": "gitsail-vscode",
  "displayName": "GitSail",
  "description": "Git context in the editor — inline blame, commit details, file and line history — reading the Git you already have installed. No extra binary to install.",
  "version": "0.0.0",
  "private": true,
  "publisher": "gitsail",
  "license": "SEE LICENSE IN ../../LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/rpaggi/gitsail.git",
    "directory": "apps/vscode"
  },
  "bugs": {
    "url": "https://github.com/rpaggi/gitsail/issues"
  },
  "homepage": "https://github.com/rpaggi/gitsail#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "GitSail",
      "properties": {
        "gitsail.blame.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show inline blame decorations in the editor (US-072). Turn off to disable them entirely.",
          "scope": "resource"
        },
        "gitsail.blame.mode": {
          "type": "string",
          "enum": [
            "currentLine",
            "allVisibleLines"
          ],
          "enumDescriptions": [
            "Only decorate the line the cursor is currently on.",
            "Decorate every currently visible line."
          ],
          "default": "currentLine",
          "description": "Which lines get an inline blame decoration (US-072 criterion 2).",
          "scope": "resource"
        },
        "gitsail.blame.delayMs": {
          "type": "number",
          "default": 400,
          "minimum": 0,
          "description": "Milliseconds of cursor inactivity before an inline blame decoration (re)appears (US-072 criterion 2). A negative value is invalid and falls back to 400ms (US-108 criterion 3).",
          "scope": "resource"
        },
        "gitsail.blame.format": {
          "type": "string",
          "default": "${author}, ${date} • ${shortHash} • ${message}",
          "markdownDescription": "Template for inline blame text. Placeholders: `${author}`, `${authorEmail}`, `${date}`, `${hash}`, `${shortHash}`, `${message}` (US-072 criterion 1).",
          "scope": "resource"
        },
        "gitsail.blame.dateStyle": {
          "type": "string",
          "enum": [
            "absolute",
            "relative"
          ],
          "enumDescriptions": [
            "A fixed calendar date, e.g. 2024-03-02.",
            "A relative duration, e.g. \"3 days ago\"."
          ],
          "default": "absolute",
          "description": "How ${date} (in the inline blame format) and the hover's date line are rendered (US-108 criterion 2). An unrecognized value falls back to \"absolute\".",
          "scope": "resource"
        },
        "gitsail.desktop.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to the GitSail Desktop executable, used by \"Open in GitSail Desktop\" (US-077). Leave empty to disable the handoff — GitSail then offers to copy the commit hash instead.",
          "scope": "resource"
        }
      }
    },
    "commands": [
      {
        "command": "gitsail.blame.toggle",
        "title": "Toggle Inline Blame",
        "category": "GitSail"
      },
      {
        "command": "gitsail.openCommitDetails",
        "title": "Open Commit Details",
        "category": "GitSail"
      },
      {
        "command": "gitsail.copyCommitHash",
        "title": "Copy Commit Hash",
        "category": "GitSail"
      },
      {
        "command": "gitsail.showFileHistory",
        "title": "Show File History",
        "category": "GitSail"
      },
      {
        "command": "gitsail.showLineHistory",
        "title": "Show Line History",
        "category": "GitSail"
      },
      {
        "command": "gitsail.openInDesktop",
        "title": "Open Commit in GitSail Desktop",
        "category": "GitSail"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "gitsail.showFileHistory",
          "group": "gitsail@1",
          "when": "resourceScheme == file"
        },
        {
          "command": "gitsail.showLineHistory",
          "group": "gitsail@2",
          "when": "resourceScheme == file && editorHasSelection"
        },
        {
          "command": "gitsail.blame.toggle",
          "group": "gitsail@3",
          "when": "resourceScheme == file"
        }
      ]
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "GitSail runs no Git query — and therefore shows no repository context, blame, or history — until the workspace is trusted, because reading a repository with git honors that repository's own configuration."
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "build": "tsc -p ./",
    "lint": "tsc --noEmit -p ./",
    "test": "vitest run",
    "test:e2e": "node ./test-e2e/runTest.js",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.6.0",
    "vitest": "^5.0.1"
  }
}
